# ============================================================
#  RetailTrove — Environment Variable Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# PostgreSQL Database
# Required for all database operations.
# For Neon: copy the connection string from your Neon dashboard.
# For local Postgres: use postgresql://user:password@localhost:5432/dbname
# ------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Individual Postgres connection parameters (used alongside DATABASE_URL
# by some tooling — drizzle-kit, pg CLI, etc.)
PGHOST=HOST
PGPORT=5432
PGDATABASE=DBNAME
PGUSER=USER
PGPASSWORD=PASSWORD

# ------------------------------------------------------------
# ------------------------------------------------------------
# Sentry Error Monitoring
# Get your DSN at https://sentry.io (or self-hosted instance).
# Leave empty in development to disable Sentry.
# ------------------------------------------------------------
SENTRY_DSN=https://your-dsn@sentry.io/project-id
VITE_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# ------------------------------------------------------------
# Upstash Redis Cache (optional)
# Caches product listings, featured/new arrivals, product detail,
# and site settings. Leave empty to disable caching (DB always hit).
# Create a free database at https://console.upstash.com/redis
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SMTP Email (Brevo / Sendinblue)
# Used for welcome emails, password resets, and newsletters.
# ------------------------------------------------------------
# Preferred: Brevo Transactional API v3 key. When set, all email is sent via
# POST https://api.brevo.com/v3/smtp/email (no SMTP credentials exposed in git).
BREVO_API_KEY=your-brevo-v3-api-key
# Fallback SMTP relay (used only when BREVO_API_KEY is unset):
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=your-brevo-login
SMTP_KEY=your-brevo-smtp-key
SMTP_FROM=RetailTrove <noreply@retailtrove.com>

# ------------------------------------------------------------
# Application
# NODE_ENV is set automatically by npm scripts (dev / build / start).
# Only set manually if you need to override it.
# ------------------------------------------------------------
# NODE_ENV=development

# ------------------------------------------------------------
# Planned — Phase 1: Authentication (Supabase)
# Uncomment and populate when Supabase Auth is integrated.
# ------------------------------------------------------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------
# Planned — Phase 2: Lemon Squeezy (Card Payments)
# Uncomment and populate when Lemon Squeezy is integrated.
# ------------------------------------------------------------
# LEMONSQUEEZY_API_KEY=your-api-key
# LEMONSQUEEZY_STORE_ID=your-store-id
# LEMONSQUEEZY_VARIANT_ID=your-variant-id
# LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret

# ------------------------------------------------------------
# Planned — Phase 2: M-Pesa (Mobile Money — Safaricom Daraja)
# Uncomment and populate when M-Pesa is integrated.
# ------------------------------------------------------------
# MPESA_CONSUMER_KEY=your-consumer-key
# MPESA_CONSUMER_SECRET=your-consumer-secret
# MPESA_SHORTCODE=your-shortcode
# MPESA_PASSKEY=your-passkey
# MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
# MPESA_ENVIRONMENT=sandbox   # sandbox | production
# Comma-separated Daraja callback IP allowlist (CIDR or exact IP).
# Strongly recommended in production; when unset callbacks are accepted from
# any IP (backwards compatible with sandbox simulation). See
# https://developer.safaricom.co.ke/DarajaAPI for published ranges.
# MPESA_CALLBACK_ALLOWED_IPS=197.248.0.0/16,196.201.0.0/16
